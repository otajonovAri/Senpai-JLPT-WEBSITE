{
  // Fayllar .js/.jsx bo'lib qoladi — TypeScript bu yerda faqat TEKSHIRUVCHI
  // (checkJs + JSDoc). Hech narsa kompilyatsiya qilinmaydi: build Vite'da.
  //
  // `include` ataylab tor: ma'lumot chegarasi (api/ + utils/ + types/).
  // Bu qatlam toza 0 xato bilan turadi. Kengaytirish uchun papkani `include`ga
  // qo'shing va JSDoc annotatsiyalarini yozing.
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client"]
  },
  "include": ["src/types", "src/api", "src/utils"]
}
