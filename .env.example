# SenpaiAri Web App Environment Variables
#
# Copy this file to .env and fill in the values.
# When VITE_API_URL is not set, the app uses mock data (demo mode).

# Backend API URL (ASP.NET Core)
# Example: https://api.senpai-ari.uz/api
# VITE_API_URL=https://your-domain.com/api

# Vocab audio bazasi — R2/S3 PublicUrl + papka prefiksi.
# Audio URL runtime'da so'zdan quriladi: {VITE_AUDIO_BASE}/{so'z}_b.mp3 (boy) / _g.mp3 (girl)
# Example: https://pub-xxxx.r2.dev/vocab
# VITE_AUDIO_BASE=
